---
/**
 * Footer — Circuit Pulse "control panel" rebuild (Phase 3.5, founder
 * direction: "the footer section is not good"). Reuses the --hero-* dark
 * tokens from global.css so it reads as the same illuminated system as
 * every page's hero band, not a one-off.
 *
 * Decision 1.6: no "Made in Tamil Nadu, serving Pan India" line —
 * positioning is global. Legal/trust items (Udyam/MSME number, registered
 * firm name) are still not decided and must never be invented.
 */
import { Image } from 'astro:assets';
import icon from '../assets/logos/v6-icon.png';
import { BRAND, NAV, TAGLINE, CONTACT_EMAIL, HAS_CONTACT_EMAIL } from '../config/site';

const year = new Date().getFullYear();
const railItems = NAV.slice(0, 4);
---

<footer class="ftr">
  <div class="ftr-inner">
    <div class="ftr-rail">
      {
        railItems.map((item, i) => (
          <div class="ftr-led" style={`animation-delay:-${i * 0.4}s`}>
            <span class="dot" style={`animation-delay:-${i * 0.4}s`} />
            {item.label.toUpperCase()}
          </div>
        ))
      }
      <div class="ftr-status">
        <span class="status-dot"></span>
        Available for projects
      </div>
    </div>

    <div class="ftr-cols">
      <div class="ftr-brand-col">
        <a href="/" class="ripple focus-ring ftr-brand">
          <Image src={icon} width={33} height={26} alt="" class="h-[26px] w-auto" />
          <span style="font-family: var(--font-display);">{BRAND}</span>
        </a>
        <p class="ftr-tagline">{TAGLINE}</p>
        {
          HAS_CONTACT_EMAIL ? (
            <a href={`mailto:${CONTACT_EMAIL}`} class="focus-ring ftr-email">
              {CONTACT_EMAIL}
            </a>
          ) : (
            <p class="ftr-email-pending">Contact details coming shortly.</p>
          )
        }
      </div>

      <div>
        <h5 class="ftr-heading">Company</h5>
        <a href="/services/" class="ftr-link">Services</a>
        <a href="/products/" class="ftr-link">Products</a>
        <a href="/portfolio/" class="ftr-link">Portfolio</a>
      </div>

      <div>
        <h5 class="ftr-heading">More</h5>
        <a href="/team/" class="ftr-link">Team</a>
        <a href="/about/" class="ftr-link">About</a>
        <a href="/contact/" class="ftr-link">Contact</a>
      </div>
    </div>

    <!-- PLACEHOLDER: registered firm name and Udyam/MSME number, once available.
         Never publish a registration number that has not actually been issued. -->

    <div class="ftr-bottom">
      <p>&copy; {year} {BRAND}. All rights reserved.</p>
      <div class="flex gap-x-6">
        <a href="/terms/" class="focus-ring ftr-legal">Terms</a>
        <a href="/privacy/" class="focus-ring ftr-legal">Privacy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr {
    margin-top: 96px;
    background: var(--hero-bg);
    color: var(--hero-text);
    position: relative;
  }
  .ftr::before {
    content: '';
    display: block;
    height: 3px;
    background: linear-gradient(90deg, #2e7cff, #22c7d9, #8ff56a, #2e7cff);
    background-size: 300% auto;
    animation: shimmer 6s linear infinite;
  }
  @keyframes shimmer {
    to {
      background-position: -300% center;
    }
  }

  .ftr-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 32px 24px 22px;
  }

  .ftr-rail {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    padding-bottom: 22px;
    margin-bottom: 26px;
    border-bottom: 1px solid var(--hero-border);
  }
  .ftr-led {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--hero-muted);
  }
  .ftr-led .dot,
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #8ff56a;
    box-shadow: 0 0 8px 2px rgba(143, 245, 106, 0.7);
    animation: node-pulse 2.4s ease-in-out infinite;
  }
  .ftr-status {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 11.5px;
    color: #8ff56a;
  }

  .ftr-cols {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .ftr-brand-col {
    max-width: 22rem;
  }
  .ftr-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    border-radius: 4px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
  }
  .ftr-tagline {
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--hero-muted);
  }
  .ftr-email {
    margin-top: 14px;
    display: inline-block;
    font-size: 13.5px;
    color: #22c7d9;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ftr-email-pending {
    margin-top: 14px;
    font-size: 13.5px;
    color: var(--hero-muted);
  }

  .ftr-heading {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #55618a;
    margin: 0 0 12px;
    font-weight: 600;
  }
  .ftr-link {
    display: block;
    font-size: 13.5px;
    color: #c9d3e6;
    text-decoration: none;
    margin-bottom: 9px;
    transition: color 0.15s ease;
    width: fit-content;
  }
  .ftr-link:hover {
    color: #22c7d9;
  }

  .ftr-bottom {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--hero-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    font-size: 11.5px;
    color: #55618a;
  }
  .ftr-legal {
    color: #55618a;
    text-decoration: none;
  }
  .ftr-legal:hover {
    color: #93a0bc;
  }

  @media (max-width: 640px) {
    .ftr-cols {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }
</style>
