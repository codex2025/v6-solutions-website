---
/**
 * Footer — Phase 2 build (decisions 2.5, 2.7, 2.11).
 *
 * Same global tokens as Header.astro. Decision 1.6: no "Made in Tamil
 * Nadu, serving Pan India" line — positioning is global. Legal/trust items
 * (Udyam/MSME number, registered firm name) are still not decided and must
 * never be invented.
 */
import { Image } from 'astro:assets';
import icon from '../assets/logos/v6-icon.png';
import { BRAND, NAV, TAGLINE, CONTACT_EMAIL, HAS_CONTACT_EMAIL } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t" style="border-color: var(--border);">
  <div class="h-[3px]" style="background: var(--grad-solid);"></div>

  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <a href="/" class="ripple focus-ring inline-flex items-center gap-2.5 rounded-sm" style="color: var(--text);">
          <Image src={icon} width={33} height={26} alt="" class="h-[26px] w-auto" />
          <span class="text-[15px] font-semibold tracking-tight" style="font-family: var(--font-display);">{BRAND}</span>
        </a>
        <p class="mt-3 text-sm" style="color: var(--muted);">{TAGLINE}</p>

        {
          HAS_CONTACT_EMAIL ? (
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="focus-ring mt-4 inline-block text-sm underline underline-offset-4"
              style="color: var(--accent-blue);"
            >
              {CONTACT_EMAIL}
            </a>
          ) : (
            <p class="mt-4 text-sm" style="color: var(--muted);">Contact details coming shortly.</p>
          )
        }
      </div>

      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-10 gap-y-2 sm:flex sm:flex-col">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="focus-ring press-feedback inline-block rounded-sm py-0.5 text-sm"
                  style="color: var(--muted);"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- PLACEHOLDER: registered firm name and Udyam/MSME number, once available.
         Never publish a registration number that has not actually been issued. -->

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t pt-6" style="border-color: var(--border);">
      <p class="text-xs" style="color: var(--muted);">&copy; {year} {BRAND}. All rights reserved.</p>
      <ul class="flex gap-x-6">
        <li>
          <a href="/terms/" class="focus-ring text-xs underline-offset-4 hover:underline" style="color: var(--muted);">Terms</a>
        </li>
        <li>
          <a href="/privacy/" class="focus-ring text-xs underline-offset-4 hover:underline" style="color: var(--muted);">Privacy</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
