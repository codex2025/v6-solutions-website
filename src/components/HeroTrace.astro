---
/**
 * The animated circuit-trace divider at the bottom of every `.hero-band`
 * (see global.css). One shared component so the path stays identical
 * everywhere it's used.
 */
---

<svg class="hero-trace" viewBox="0 0 800 56" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 44 L120 44 L160 16 L260 16 L300 44 L500 44 L540 16 L640 16 L680 44 L800 44" />
  <path class="trace" d="M0 44 L120 44 L160 16 L260 16 L300 44 L500 44 L540 16 L640 16 L680 44 L800 44" />
</svg>
