---
/**
 * Header — STRUCTURAL SHELL ONLY (Phase 1).
 *
 * Visual style is deliberately undecided: CLAUDE.md requires that header
 * variants (transparent-over-hero / solid with contact strip / minimal centred)
 * are offered to the founder before one is built. That happens in Phase 2.
 * Everything below is neutral scaffolding, not a design proposal.
 *
 * Mobile menu uses <details>/<summary> so it works with JavaScript disabled.
 */
import { BRAND_MARK, NAV } from '../config/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="border-b border-neutral-200">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
    <a
      href="/"
      class="text-lg font-semibold tracking-tight text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
    >
      {BRAND_MARK}
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Primary" class="hidden sm:block">
      <ul class="flex items-center gap-6">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="text-sm text-neutral-700 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900 aria-[current=page]:font-semibold aria-[current=page]:text-neutral-900"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile navigation: no JavaScript required -->
    <details class="sm:hidden">
      <summary
        class="cursor-pointer list-none rounded border border-neutral-300 px-3 py-2 text-sm text-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
      >
        Menu
      </summary>
      <nav aria-label="Primary" class="absolute right-4 z-10 mt-2 rounded border border-neutral-200 bg-white p-2 shadow-lg">
        <ul class="flex min-w-40 flex-col">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="block px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-neutral-900 aria-[current=page]:font-semibold aria-[current=page]:text-neutral-900"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
