---
/**
 * Contact — Circuit Pulse hero (decision 2.14), styled as one continuous
 * dark panel straight into the footer (there's no separate light body here
 * — the page is short enough that a hero-band-to-footer transition reads
 * as a deliberate "focused CTA screen", not a missing section). The ping
 * rings are this page's own motif: literally "reaching out".
 *
 * No working form yet: no Web3Forms/Formspree access key, no real business
 * email (src/config/site.ts still has the PLACEHOLDER). Per the Phase 1.5
 * precedent (DECISIONS.md), a form that silently discards messages is worse
 * than none — so this stays mailto/fallback-only until both exist.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { BRAND, CONTACT_EMAIL, HAS_CONTACT_EMAIL } from '../config/site';

const description = `Get in touch with ${BRAND}.`;
---

<BaseLayout title="Contact" description={description}>
  <PageHero eyebrow="Contact" accent="#4e9e2a">
    <div class="ping-wrap" aria-hidden="true">
      <span class="ping-ring r1"></span>
      <span class="ping-ring r2"></span>
      <span class="ping-ring r3"></span>
    </div>

    <div class="relative mx-auto flex min-h-[80vh] max-w-2xl flex-col items-center justify-center py-10 text-center sm:py-16" data-reveal-group>
      <h1
        data-reveal-item
        class="text-[clamp(2rem,4.4vw,3.1rem)] leading-[1.1] font-semibold tracking-tight text-balance"
        style="font-family: var(--font-display);"
      >
        Tell us what you're building.
      </h1>
      <p data-reveal-item class="mt-5 text-base leading-relaxed" style="color: var(--hero-muted);">
        We'll tell you honestly if we're the right fit — and point you elsewhere if we're not.
      </p>

      <div class="mt-10" data-reveal-item>
        {
          HAS_CONTACT_EMAIL ? (
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              data-magnetic
              class="ripple focus-ring press-feedback inline-block rounded-full px-7 py-3.5 text-sm font-semibold"
              style="background: linear-gradient(120deg, #2e7cff, #22c7d9); color: #fff; box-shadow: 0 0 24px 2px rgba(46,124,255,.35);"
            >
              {CONTACT_EMAIL}
            </a>
          ) : (
            <p
              class="rounded-2xl border p-6 text-sm"
              style="border-color: var(--hero-border); background: rgba(255,255,255,0.04); color: var(--hero-muted);"
            >
              Contact details are coming shortly — we're finishing setup on a business email address.
            </p>
          )
        }
      </div>
    </div>
  </PageHero>
</BaseLayout>

<style>
  .ping-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 1px;
    z-index: 0;
  }
  .ping-ring {
    position: absolute;
    top: 0;
    left: 0;
    border: 1px solid #4e9e2a;
    border-radius: 999px;
    transform: translate(-50%, -50%);
    animation: ping-out 3.6s ease-out infinite;
    opacity: 0;
  }
  .r1 {
    animation-delay: 0s;
  }
  .r2 {
    animation-delay: -1.2s;
  }
  .r3 {
    animation-delay: -2.4s;
  }
  @keyframes ping-out {
    0% {
      width: 12px;
      height: 12px;
      opacity: 0.6;
    }
    100% {
      width: 620px;
      height: 620px;
      opacity: 0;
    }
  }
</style>
