---
/**
 * Contact — light theme per decision 2.6.
 *
 * No working form yet: no Web3Forms/Formspree access key, no real business
 * email (src/config/site.ts still has the PLACEHOLDER). Per the Phase 1.5
 * precedent (DECISIONS.md), a form that silently discards messages is worse
 * than none — so this stays mailto/fallback-only until both exist.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND, CONTACT_EMAIL, HAS_CONTACT_EMAIL } from '../config/site';

const description = `Get in touch with ${BRAND}.`;
---

<BaseLayout title="Contact" description={description} theme="light">
  <section class="px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">Contact</p>
      <h1 class="mt-3 text-[clamp(2rem,4.4vw,3.1rem)] leading-[1.1] font-semibold tracking-tight text-balance" style="font-family: var(--font-display); color: var(--text);">
        Tell us what you're building.
      </h1>
      <p class="mt-5 text-base leading-relaxed" style="color: var(--muted);">
        We'll tell you honestly if we're the right fit — and point you elsewhere if we're not.
      </p>

      <div class="mt-10">
        {
          HAS_CONTACT_EMAIL ? (
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              data-magnetic
              class="ripple focus-ring press-feedback inline-block rounded-full px-7 py-3.5 text-sm font-semibold"
              style="background: var(--btn-bg); color: var(--btn-text);"
            >
              {CONTACT_EMAIL}
            </a>
          ) : (
            <p class="rounded-2xl border p-6 text-sm" style="border-color: var(--border); background: var(--surface); color: var(--muted);">
              Contact details are coming shortly — we're finishing setup on a business email address.
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
