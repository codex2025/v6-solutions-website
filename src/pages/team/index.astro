---
/**
 * Team index.
 *
 * Uses the main site's BaseLayout/Header/Footer, unlike each individual
 * founder page (/team/[slug]/), which deliberately stays on the separate
 * PortfolioLayout with no site chrome (decisions 1.14-1.17: every founder's
 * page is its own fully customised space). The index itself is a company
 * page, not any one founder's space, so it belongs in the main nav like
 * Services and Portfolio.
 *
 * CLAUDE.md: "All six are equal — no visual hierarchy among founder cards."
 * So this grid is uniform: same card, same size, alphabetical order (not
 * seniority, not who shipped first). Each founder's own accent tints only
 * their own card's hover state.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { BRAND } from '../../config/site';

const founders = (await getCollection('founders')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

/** Trim to a word boundary so cards never end mid-word ("…AR/VR simulat…"). */
const excerpt = (text: string, max = 130) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  return `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:.]$/, '')}…`;
};

const DEFAULT_ACCENT = '#0b45d6';
---

<BaseLayout title="Team" description={`The people behind ${BRAND} — engineers, designers and builders.`}>
  <PageHero eyebrow="The team" accent="#0b45d6">
    <!-- Six nodes, not the usual three — one per founder. -->
    <div class="hero-node" style="top:18%;left:62%;background:#0b45d6;box-shadow:0 0 10px 2px #0b45d6;"></div>
    <div class="hero-node" style="top:40%;left:88%;animation-delay:-.5s;background:#0a8b99;box-shadow:0 0 10px 2px #0a8b99;"></div>
    <div class="hero-node" style="top:78%;left:70%;animation-delay:-1.1s;background:#4e9e2a;box-shadow:0 0 10px 2px #4e9e2a;"></div>
    <div class="hero-node" style="top:60%;left:50%;animation-delay:-1.7s;background:#22c7d9;box-shadow:0 0 10px 2px #22c7d9;"></div>

    <div data-reveal-group>
      <h1
        data-reveal-item
        class="mt-4 max-w-2xl text-[clamp(2rem,4.4vw,3.1rem)] leading-[1.1] font-semibold tracking-tight text-balance"
        style="font-family: var(--font-display);"
      >
        People who build.
      </h1>
      <p data-reveal-item class="mt-5 max-w-xl text-base leading-relaxed" style="color: var(--hero-muted);">
        Six equal founders. Each one keeps their own portfolio — click through for the full picture.
      </p>
    </div>
  </PageHero>

  <section class="px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-6xl">
      {
        founders.length === 0 && (
          <p class="text-sm" style="color: var(--muted);">
            {/* PLACEHOLDER: replace with real content */}
            Founder profiles are being added.
          </p>
        )
      }

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {
          founders.map((f) => {
            const hasPage = Boolean(f.data.portfolio?.enabled);
            const accent = f.data.portfolio?.theme.accent ?? DEFAULT_ACCENT;
            const Tag = hasPage ? 'a' : 'div';

            return (
              <Tag
                data-reveal-item
                data-tilt={hasPage ? true : undefined}
                class={`team-card ${hasPage ? 'ripple focus-ring' : ''} flex flex-col gap-4 rounded-2xl border p-6`}
                style={`border-color: var(--border); background: var(--surface); --card-accent: ${accent};`}
                {...(hasPage ? { href: `/team/${f.data.slug}/` } : {})}
              >
                {f.data.photo ? (
                  <Image
                    src={f.data.photo}
                    alt={`Portrait of ${f.data.name}`}
                    width={64}
                    height={64}
                    class="h-16 w-16 rounded-full object-cover"
                  />
                ) : (
                  <div
                    class="flex h-16 w-16 items-center justify-center rounded-full text-sm font-semibold"
                    style={`background: color-mix(in srgb, ${accent} 16%, transparent); color: ${accent};`}
                    aria-hidden="true"
                  >
                    {initials(f.data.name)}
                  </div>
                )}

                <div>
                  <h2 class="text-[15px] font-semibold" style="color: var(--text);">
                    {f.data.name}
                  </h2>
                  <p class="mt-0.5 text-[12.5px]" style={`font-family: var(--font-display); color: ${accent};`}>
                    {f.data.role}
                  </p>
                </div>

                <p class="text-[13px] leading-relaxed" style="color: var(--muted);">
                  {excerpt(f.data.bio)}
                </p>

                <div class="flex flex-wrap gap-1.5">
                  {f.data.domains.slice(0, 3).map((dm) => (
                    <span
                      class="rounded-full px-2 py-0.5 text-[10.5px] font-medium"
                      style="background: var(--bg); color: var(--muted); border: 1px solid var(--border);"
                    >
                      {dm}
                    </span>
                  ))}
                </div>

                {hasPage && (
                  <p class="mt-1 text-[11px] font-semibold tracking-wide uppercase" style={`color: ${accent};`}>
                    View portfolio &rarr;
                  </p>
                )}
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .team-card {
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }
  a.team-card:hover,
  a.team-card:focus-visible {
    border-color: color-mix(in srgb, var(--card-accent) 55%, var(--border));
    box-shadow: 0 12px 32px -18px color-mix(in srgb, var(--card-accent) 45%, transparent);
  }
  [data-motion-tier='lite'] a.team-card:hover {
    transform: translateY(-3px);
  }
</style>
