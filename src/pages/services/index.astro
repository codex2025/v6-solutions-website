---
/**
 * Services index. Circuit Pulse hero (decision 2.14) — the floating
 * badges scattered in the hero use the real per-service icons/colours
 * instead of generic dots, so this page's hero reads as "services"
 * specifically rather than a copy of every other page's hero.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { TAGLINE } from '../../config/site';
import { SERVICE_ICONS } from '../../lib/service-icons';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const description = 'Eight fields, one accountable team — IT, design, hardware, CCTV, CAD, AR/VR & AI, marketing and video.';

const floatingIcons = [services[0], services[3], services[5], services[7]].map((s, i) => ({
  icon: SERVICE_ICONS[s.data.icon],
  pos: [
    { top: '14%', right: '4%' },
    { top: '68%', right: '10%' },
    { top: '30%', right: '20%' },
    { top: '80%', right: '2%' },
  ][i],
}));
---

<BaseLayout title="Services" description={description}>
  <PageHero eyebrow={TAGLINE} accent="#22c7d9">
    {
      floatingIcons.map(({ icon, pos }) => (
        <span
          class="hero-float-icon hidden lg:flex"
          style={`top:${pos.top};right:${pos.right};color:${icon.accent};box-shadow:0 0 16px 2px ${icon.accent}66;`}
          aria-hidden="true"
        >
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" set:html={icon.svg} />
        </span>
      ))
    }

    <div data-reveal-group>
      <h1
        data-reveal-item
        class="mt-4 max-w-2xl text-[clamp(2rem,4.4vw,3.1rem)] leading-[1.1] font-semibold tracking-tight text-balance"
        style="font-family: var(--font-display);"
      >
        Eight fields, one accountable team.
      </h1>
      <p data-reveal-item class="mt-5 max-w-xl text-base leading-relaxed" style="color: var(--hero-muted);">
        Software and design ship anywhere. Hardware automation and CCTV are on-site work — for now, that's India only.
      </p>
    </div>
  </PageHero>

  <section class="px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        services.map((service) => {
          const icon = SERVICE_ICONS[service.data.icon];
          return (
            <a
              href={`/services/${service.data.slug}/`}
              data-reveal-item
              data-tilt
              class="service-card ripple focus-ring flex flex-col gap-4 rounded-2xl border p-6"
              style={`border-color: var(--border); background: var(--surface); --card-accent: ${icon.accent};`}
            >
              <div class="flex items-center justify-between">
                <span
                  class="flex h-11 w-11 items-center justify-center rounded-lg"
                  style={`background: color-mix(in srgb, ${icon.accent} 14%, transparent); color: ${icon.accent};`}
                >
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={icon.svg} />
                </span>
                <span
                  class="rounded-full px-2.5 py-1 text-[10px] font-semibold tracking-wide uppercase"
                  style={`background: color-mix(in srgb, ${icon.accent} 12%, transparent); color: ${icon.accent};`}
                >
                  {service.data.coverage === 'india' ? 'India' : 'Worldwide'}
                </span>
              </div>
              <div>
                <h2 class="text-[15px] font-semibold" style="color: var(--text);">
                  {service.data.title}
                </h2>
                <p class="mt-1.5 text-[13px] leading-relaxed" style="color: var(--muted);">
                  {service.data.tagline}
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .service-card {
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }
  .service-card:hover,
  .service-card:focus-visible {
    border-color: color-mix(in srgb, var(--card-accent) 55%, var(--border));
    box-shadow: 0 12px 32px -18px color-mix(in srgb, var(--card-accent) 45%, transparent);
  }
  [data-motion-tier='lite'] .service-card:hover {
    transform: translateY(-3px);
  }

  .hero-float-icon {
    position: absolute;
    z-index: 0;
    width: 40px;
    height: 40px;
    padding: 9px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(6px);
    animation: levitate 6s ease-in-out infinite;
  }
</style>
