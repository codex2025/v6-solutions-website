---
/**
 * Service detail — one page per markdown file in src/content/services/ — a
 * founder adds a 9th service with zero code changes (CLAUDE.md's stated
 * goal for content collections).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SERVICE_ICONS } from '../../lib/service-icons';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.data.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { title, tagline, summary, deliverables, process, faq, coverage, icon: iconKey } = service.data;
const icon = SERVICE_ICONS[iconKey];

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allServices.findIndex((s) => s.data.slug === service.data.slug);
const next = allServices[(currentIndex + 1) % allServices.length];
---

<BaseLayout title={title} description={summary}>
  <section class="px-4 pt-16 pb-14 sm:px-6 sm:pt-20">
    <div class="mx-auto max-w-3xl" data-reveal>
      <a href="/services/" class="focus-ring text-xs font-semibold" style="color: var(--muted);">&larr; All services</a>

      <div class="mt-5 flex items-center gap-4">
        <span
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl"
          style={`background: color-mix(in srgb, ${icon.accent} 14%, transparent); color: ${icon.accent};`}
        >
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8" set:html={icon.svg} />
        </span>
        <span
          class="rounded-full px-2.5 py-1 text-[10px] font-semibold tracking-wide uppercase"
          style={`background: color-mix(in srgb, ${icon.accent} 12%, transparent); color: ${icon.accent};`}
        >
          {coverage === 'india' ? 'India — on-site' : 'Worldwide'}
        </span>
      </div>

      <h1 class="mt-6 text-[clamp(1.9rem,4vw,2.75rem)] leading-[1.12] font-semibold tracking-tight text-balance" style="font-family: var(--font-display); color: var(--text);">
        {title}
      </h1>
      <p class="mt-3 text-lg" style="color: var(--accent-blue);">{tagline}</p>
      <p class="mt-5 max-w-2xl text-base leading-relaxed" style="color: var(--muted);">{summary}</p>

      <a
        href="/contact/"
        data-magnetic
        class="ripple focus-ring press-feedback mt-8 inline-block rounded-full px-6 py-3 text-sm font-semibold"
        style="background: var(--btn-bg); color: var(--btn-text);"
      >
        Start a project
      </a>
    </div>
  </section>

  <section class="px-4 pb-16 sm:px-6" style="background: var(--surface);">
    <div class="mx-auto max-w-3xl py-16">
      <h2 class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">What's included</h2>
      <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2" data-reveal-group>
        {
          deliverables.map((item) => (
            <li data-reveal-item class="flex items-start gap-2.5 rounded-lg border p-3.5 text-sm" style="border-color: var(--border); background: var(--bg); color: var(--text);">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${icon.accent};`} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">How it runs</h2>
      <ol class="relative mt-6 border-l pl-6" style="border-color: var(--border);" data-reveal-group>
        {
          process.map((p, i) => (
            <li data-reveal-item class="relative pb-8 last:pb-0">
              <span
                class="absolute top-0.5 -left-[31px] flex h-6 w-6 items-center justify-center rounded-full text-[11px] font-semibold"
                style={`background: color-mix(in srgb, ${icon.accent} 18%, var(--surface)); color: ${icon.accent};`}
              >
                {i + 1}
              </span>
              <h3 class="text-sm font-semibold" style="color: var(--text);">{p.step}</h3>
              <p class="mt-1 text-sm leading-relaxed" style="color: var(--muted);">{p.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    faq.length > 0 && (
      <section class="px-4 py-16 sm:px-6" style="background: var(--surface);">
        <div class="mx-auto max-w-3xl py-6">
          <h2 class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">Questions</h2>
          <div class="mt-5 flex flex-col gap-3">
            {faq.map((item) => (
              <details class="group rounded-lg border p-4" style="border-color: var(--border); background: var(--bg);">
                <summary class="focus-ring cursor-pointer list-none text-sm font-semibold" style="color: var(--text);">
                  {item.question}
                </summary>
                <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted);">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="px-4 py-16 text-center sm:px-6" data-reveal>
    <p class="text-xs" style="color: var(--muted);">Next</p>
    <a href={`/services/${next.data.slug}/`} class="focus-ring mt-1 inline-block text-lg font-semibold" style="font-family: var(--font-display); color: var(--text);">
      {next.data.title} &rarr;
    </a>
  </section>
</BaseLayout>
