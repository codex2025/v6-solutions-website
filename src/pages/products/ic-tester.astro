---
/**
 * IC Tester — flagship in-house product per CLAUDE.md ("proof we build
 * products, not just services").
 *
 * Everything here is honest "in development" framing — no invented specs,
 * pricing, ship dates or progress numbers. CLAUDE.md: honest "coming soon"
 * beats fake proof.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HAS_CONTACT_EMAIL, CONTACT_EMAIL } from '../../config/site';

const description = 'A low-cost IC tester — in-house electronics test equipment, currently in development.';
---

<BaseLayout title="Low-Cost IC Tester" description={description}>
  <section class="relative overflow-hidden px-4 pt-14 pb-16 sm:px-6 sm:pt-20 sm:pb-20">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60"
      style="background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 34px 34px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black, transparent);"
    >
    </div>

    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_1fr]" data-reveal-group>
      <div data-reveal-item>
        <a href="/products/" class="focus-ring text-xs font-semibold" style="color: var(--muted);">&larr; Products</a>
        <p class="mt-5 text-xs font-semibold tracking-[0.22em] uppercase" style="color: var(--accent-lime);">In development</p>
        <h1
          class="mt-4 text-[clamp(2.1rem,4.6vw,3.4rem)] leading-[1.08] font-semibold tracking-tight text-balance"
          style="font-family: var(--font-display); color: var(--text);"
        >
          Low-Cost IC Tester
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed" style="color: var(--muted);">
          Affordable electronics test equipment for checking whether an integrated circuit still works — built
          because we needed one ourselves and couldn't find one that didn't cost a fortune.
        </p>
        {
          HAS_CONTACT_EMAIL ? (
            <a
              href={`mailto:${CONTACT_EMAIL}?subject=IC Tester updates`}
              data-magnetic
              class="ripple focus-ring press-feedback mt-9 inline-block rounded-full px-6 py-3 text-sm font-semibold"
              style="background: var(--btn-bg); color: var(--btn-text);"
            >
              Get updates when it ships
            </a>
          ) : (
            <a
              href="/contact/"
              data-magnetic
              class="ripple focus-ring press-feedback mt-9 inline-block rounded-full px-6 py-3 text-sm font-semibold"
              style="background: var(--btn-bg); color: var(--btn-text);"
            >
              Get in touch about it
            </a>
          )
        }
      </div>

      <div class="relative aspect-[4/3] w-full max-w-md justify-self-center lg:max-w-none" data-reveal-item>
        <div data-three-scene="chip" class="hero-scene absolute inset-0" aria-hidden="true"></div>
        <div class="hero-fallback absolute inset-0 flex items-center justify-center" aria-hidden="true">
          <svg viewBox="0 0 240 160" class="h-full w-full max-w-[320px] opacity-80">
            <defs>
              <linearGradient id="chip-fallback-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#4c8cff"></stop>
                <stop offset="100%" stop-color="#9cfa7c"></stop>
              </linearGradient>
            </defs>
            <g fill="none" stroke="url(#chip-fallback-grad)" stroke-width="1.5" stroke-linecap="round">
              <rect x="60" y="55" width="120" height="50" rx="4"></rect>
              <circle cx="72" cy="66" r="2.5" fill="url(#chip-fallback-grad)" stroke="none"></circle>
              {Array.from({ length: 6 }).map((_, i) => (
                <line x1={45} y1={64 + i * 8} x2={60} y2={64 + i * 8}></line>
              ))}
              {Array.from({ length: 6 }).map((_, i) => (
                <line x1={180} y1={64 + i * 8} x2={195} y2={64 + i * 8}></line>
              ))}
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6" style="background: var(--surface);">
    <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-2" data-reveal-group>
      <div data-reveal-item>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">The problem</p>
        <h2 class="mt-3 text-xl font-semibold" style="font-family: var(--font-display); color: var(--text);">
          Real IC testers are expensive.
        </h2>
        <p class="mt-3 text-sm leading-relaxed" style="color: var(--muted);">
          Commercial IC testers exist, but the good ones price out hobbyists, repair shops, small manufacturers and
          students — exactly the people who'd use one most often, in smaller batches.
        </p>
      </div>
      <div data-reveal-item>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-lime);">Our approach</p>
        <h2 class="mt-3 text-xl font-semibold" style="font-family: var(--font-display); color: var(--text);">
          Build the affordable version ourselves.
        </h2>
        <p class="mt-3 text-sm leading-relaxed" style="color: var(--muted);">
          We're an electronics and software team — this is the kind of tool we'd reach for ourselves, so we're
          building it in-house rather than waiting for someone else to.
        </p>
      </div>
    </div>
  </section>

  <section class="px-4 py-20 text-center sm:px-6" data-reveal>
    <p class="mx-auto max-w-lg text-sm leading-relaxed" style="color: var(--muted);">
      No specs, pricing or launch date yet — this is still an active build, not a finished product. We'd rather say
      that plainly than promise something before it's real.
    </p>
  </section>
</BaseLayout>

<style>
  .hero-scene {
    z-index: 2;
  }
  .hero-fallback {
    z-index: 1;
    transition: opacity 0.6s ease;
  }
  [data-three-scene]:not(:empty) ~ .hero-fallback {
    opacity: 0;
  }
</style>
