---
/**
 * 404 — light theme per decision 2.6.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../config/site';
---

<BaseLayout title={`Page not found — ${BRAND}`} description="Page not found." theme="light" noindex>
  <section class="flex min-h-[70vh] flex-col items-center justify-center px-4 text-center sm:px-6">
    <p class="text-sm font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">404</p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight" style="font-family: var(--font-display); color: var(--text);">
      That page doesn't exist.
    </h1>
    <p class="mt-3 text-sm" style="color: var(--muted);">Maybe it moved, or maybe it was never built.</p>
    <a
      href="/"
      class="ripple focus-ring press-feedback mt-8 inline-block rounded-full px-6 py-3 text-sm font-semibold"
      style="background: var(--btn-bg); color: var(--btn-text);"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
