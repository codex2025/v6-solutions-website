---
/**
 * Portfolio index.
 *
 * Real projects only (CLAUDE.md: never invent a client or a project). The
 * four entries here are founder Shyamalan V's own personal/academic work,
 * sourced from his own repo — see src/content/projects/*.md. As client
 * projects are delivered and cleared to publish, they get their own
 * markdown file the same way.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { BRAND } from '../../config/site';
import { SERVICE_ICONS } from '../../lib/service-icons';

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);

const cards = await Promise.all(
  projects.map(async (project) => {
    const service = await getEntry(project.data.service);
    return { project, service };
  }),
);

const description = `Real work from ${BRAND} — client projects publish here once cleared to share.`;
---

<BaseLayout title="Portfolio" description={description}>
  <PageHero eyebrow="Portfolio" accent="#2e7cff">
    <div data-reveal-group>
      <h1
        data-reveal-item
        class="mt-4 max-w-2xl text-[clamp(2rem,4.4vw,3.1rem)] leading-[1.1] font-semibold tracking-tight text-balance"
        style="font-family: var(--font-display);"
      >
        Real work, not a mockup gallery.
      </h1>
      <p data-reveal-item class="mt-5 max-w-xl text-base leading-relaxed" style="color: var(--hero-muted);">
        Client work publishes here once cleared to share. What's below is real, sourced work from our own team.
      </p>
    </div>
  </PageHero>

  <section class="px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-4 sm:grid-cols-2" data-reveal-group>
      {
        cards.map(({ project, service }) => {
          const icon = SERVICE_ICONS[service?.data.icon ?? 'code'];
          return (
            <a
              href={`/portfolio/${project.data.slug}/`}
              data-reveal-item
              data-tilt
              class="project-card ripple focus-ring flex flex-col gap-4 rounded-2xl border p-6"
              style={`border-color: var(--border); background: var(--surface); --card-accent: ${icon.accent};`}
            >
              <div class="flex items-center justify-between">
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-lg"
                  style={`background: color-mix(in srgb, ${icon.accent} 14%, transparent); color: ${icon.accent};`}
                >
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" set:html={icon.svg} />
                </span>
                <span class="text-xs" style="color: var(--muted);">{project.data.year}</span>
              </div>

              <div>
                <h2 class="text-[16px] font-semibold" style="color: var(--text);">
                  {project.data.title}
                </h2>
                <p class="mt-0.5 text-[12px]" style="color: var(--muted);">
                  {project.data.client} · {service?.data.title}
                </p>
              </div>

              <p class="text-[13px] leading-relaxed" style="color: var(--muted);">
                {project.data.solution}
              </p>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .project-card {
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }
  .project-card:hover,
  .project-card:focus-visible {
    border-color: color-mix(in srgb, var(--card-accent) 55%, var(--border));
    box-shadow: 0 12px 32px -18px color-mix(in srgb, var(--card-accent) 45%, transparent);
  }
  [data-motion-tier='lite'] .project-card:hover {
    transform: translateY(-3px);
  }
</style>
