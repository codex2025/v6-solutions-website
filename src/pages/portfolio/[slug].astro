---
/**
 * Project detail.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SERVICE_ICONS } from '../../lib/service-icons';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, client, year, problem, solution, outcome, testimonial } = project.data;
const service = await getEntry(project.data.service);
const icon = SERVICE_ICONS[service?.data.icon ?? 'code'];
const description = solution;
---

<BaseLayout title={title} description={description}>
  <PageHero eyebrow={`${client} · ${year}`} accent={icon.accent} compact>
    <a slot="pretext" href="/portfolio/" class="focus-ring mb-6 inline-block text-xs font-semibold" style="color: var(--hero-muted);">&larr; Portfolio</a>

    <div data-reveal-group>
      <div class="mt-5 flex items-center gap-4" data-reveal-item>
        <span
          class="levitate flex h-14 w-14 shrink-0 items-center justify-center rounded-xl"
          style={`background: color-mix(in srgb, ${icon.accent} 18%, transparent); color: ${icon.accent}; box-shadow: 0 0 24px 4px ${icon.accent}55;`}
        >
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8" set:html={icon.svg} />
        </span>
        {service && (
          <a href={`/services/${service.data.slug}/`} class="focus-ring text-xs font-semibold" style={`color: ${icon.accent};`}>
            {service.data.title}
          </a>
        )}
      </div>

      <h1
        data-reveal-item
        class="mt-6 text-[clamp(1.9rem,4vw,2.75rem)] leading-[1.12] font-semibold tracking-tight text-balance"
        style="font-family: var(--font-display);"
      >
        {title}
      </h1>
    </div>
  </PageHero>

  <section class="px-4 pb-16 sm:px-6" style="background: var(--surface);">
    <div class="mx-auto grid max-w-3xl gap-8 py-16 sm:grid-cols-3" data-reveal-group>
      <div data-reveal-item>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">Problem</p>
        <p class="mt-3 text-sm leading-relaxed" style="color: var(--text);">{problem}</p>
      </div>
      <div data-reveal-item>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">Solution</p>
        <p class="mt-3 text-sm leading-relaxed" style="color: var(--text);">{solution}</p>
      </div>
      <div data-reveal-item>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">Outcome</p>
        <p class="mt-3 text-sm leading-relaxed" style="color: var(--text);">{outcome}</p>
      </div>
    </div>
  </section>

  {
    testimonial && (
      <section class="px-4 py-16 sm:px-6" data-reveal>
        <blockquote class="mx-auto max-w-2xl border-l-2 pl-6" style="border-color: var(--accent-blue);">
          <p class="text-lg leading-relaxed" style="color: var(--text);">"{testimonial.quote}"</p>
          <footer class="mt-3 text-sm" style="color: var(--muted);">
            — {testimonial.author}
            {testimonial.role && `, ${testimonial.role}`}
          </footer>
        </blockquote>
      </section>
    )
  }

  <section class="px-4 py-16 text-center sm:px-6" data-reveal>
    <a
      href="/contact/"
      data-magnetic
      class="ripple focus-ring press-feedback inline-block rounded-full px-6 py-3 text-sm font-semibold"
      style="background: var(--btn-bg); color: var(--btn-text);"
    >
      Start something like this
    </a>
  </section>
</BaseLayout>
