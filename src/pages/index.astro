---
/**
 * Home — Phase 3 build, Phase 2 visual system (DECISIONS.md § Phase 2).
 *
 * Dark page per decision 2.6 (split by page type: Home / About / Products
 * are dark). Rich-tier visitors get the procedural Three.js hero scene and
 * GSAP scroll choreography (decisions 2.7-2.10); everyone else gets the
 * CSS-only lite tier — see src/scripts/motion.ts for the capability gate.
 *
 * Service one-liners here are a first draft, not founder-approved copy —
 * flagged for review at the Phase 2 check-in (DECISIONS.md open items).
 * Nothing invented: no stats, no client names, no claims beyond what
 * CLAUDE.md already states about the business.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND, TAGLINE, ONE_LINER } from '../config/site';

interface Service {
  title: string;
  blurb: string;
  accent: string;
  icon: string;
}

const services: Service[] = [
  {
    title: 'IT & Software Development',
    blurb: 'Web apps, internal tools and systems built to spec.',
    accent: '#2e7cff',
    icon: `<path d="M17 14 L8 24 L17 34" /><path d="M31 14 L40 24 L31 34" /><line x1="24" y1="16" x2="24" y2="32" stroke-width="2.5" />`,
  },
  {
    title: 'Design — Graphic, 3D & Visual',
    blurb: 'Brand identity, 3D renders and visuals that look like they belong to you.',
    accent: '#22c7d9',
    icon: `<circle cx="18" cy="19" r="9" stroke="#4c8cff" /><circle cx="30" cy="19" r="9" stroke="#3cd3e4" /><circle cx="24" cy="29" r="9" stroke="#9cfa7c" />`,
  },
  {
    title: 'Hardware Automation',
    blurb: 'Embedded systems and automation hardware, prototyped in-house.',
    accent: '#1fa6d9',
    icon: `<circle cx="24" cy="24" r="10" /><circle cx="24" cy="24" r="4" /><line x1="24" y1="6" x2="24" y2="12" /><line x1="24" y1="36" x2="24" y2="42" /><line x1="6" y1="24" x2="12" y2="24" /><line x1="36" y1="24" x2="42" y2="24" /><line x1="10.9" y1="10.9" x2="15" y2="15" /><line x1="33" y1="33" x2="37.1" y2="37.1" /><line x1="10.9" y1="37.1" x2="15" y2="33" /><line x1="33" y1="15" x2="37.1" y2="10.9" />`,
  },
  {
    title: 'CCTV & Security Infrastructure',
    blurb: 'Installation and monitoring for sites across India.',
    accent: '#17b7c7',
    icon: `<rect x="9" y="19" width="20" height="12" rx="3" /><circle cx="19" cy="25" r="4" /><path d="M29 22 L38 17 V33 L29 28" /><path d="M33 12 C37.5 16.5 37.5 31.5 33 36" stroke-dasharray="2 3" />`,
  },
  {
    title: 'CAD & Engineering Drawings',
    blurb: 'Precise drawings and models, ready for production.',
    accent: '#0fc7b0',
    icon: `<path d="M8 36 L8 14 L30 36 Z" /><circle cx="34" cy="18" r="2" /><path d="M34 20 L34 28" stroke-dasharray="1 3" /><path d="M26 30 A8 8 0 0 0 34 30" />`,
  },
  {
    title: 'AR/VR & AI Solutions',
    blurb: 'Immersive and intelligent experiences, built for real use cases.',
    accent: '#3fd79a',
    icon: `<path d="M24 8 L38 16 V32 L24 40 L10 32 V16 Z" /><circle cx="24" cy="24" r="3" /><line x1="24" y1="24" x2="24" y2="14" /><line x1="24" y1="24" x2="33" y2="29" /><line x1="24" y1="24" x2="15" y2="29" /><circle cx="24" cy="14" r="1.6" fill="currentColor" /><circle cx="33" cy="29" r="1.6" fill="currentColor" /><circle cx="15" cy="29" r="1.6" fill="currentColor" />`,
  },
  {
    title: 'Digital Marketing',
    blurb: 'Campaigns and strategy that reach the right audience.',
    accent: '#6be97c',
    icon: `<line x1="8" y1="40" x2="40" y2="40" /><rect x="12" y="28" width="6" height="12" /><rect x="21" y="20" width="6" height="20" /><rect x="30" y="12" width="6" height="28" /><path d="M28 16 L38 8" /><path d="M31 8 H38 V15" />`,
  },
  {
    title: 'Video Editing',
    blurb: 'Footage cut, graded and finished for release.',
    accent: '#84f660',
    icon: `<rect x="8" y="20" width="32" height="18" rx="2" /><path d="M8 20 L14 12 H20 L16 20" /><path d="M20 20 L26 12 H32 L28 20" /><path d="M32 20 L38 12 H40 V20" /><line x1="16" y1="28" x2="30" y2="28" />`,
  },
];
---

<BaseLayout title={BRAND} description={ONE_LINER} theme="dark">
  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden px-4 pt-14 pb-20 sm:px-6 sm:pt-20 sm:pb-28">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60"
      style="background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 34px 34px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black, transparent);"
    >
    </div>

    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.1fr_1fr]" data-reveal-group>
      <div data-reveal-item>
        <p
          class="text-xs font-semibold uppercase tracking-[0.22em]"
          style="background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent;"
        >
          {TAGLINE}
        </p>
        <h1
          class="mt-5 text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.08] font-semibold tracking-tight text-balance"
          style="font-family: var(--font-display); color: var(--text);"
        >
          Hardware. Software. Design.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed" style="color: var(--muted);">
          {ONE_LINER}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="/contact/"
            data-magnetic
            class="ripple focus-ring press-feedback rounded-full px-6 py-3 text-sm font-semibold"
            style="background: var(--btn-bg); color: var(--btn-text);"
          >
            Start a project
          </a>
          <a
            href="/portfolio/"
            data-magnetic
            class="ripple focus-ring press-feedback rounded-full border px-6 py-3 text-sm font-semibold"
            style="border-color: var(--border); color: var(--text);"
          >
            See our work
          </a>
        </div>
      </div>

      <div class="relative aspect-square w-full max-w-md justify-self-center lg:max-w-none" data-reveal-item>
        <div data-three-scene="nodes" class="hero-scene absolute inset-0" aria-hidden="true"></div>
        <div class="hero-fallback absolute inset-0 flex items-center justify-center" aria-hidden="true">
          <svg viewBox="0 0 240 190" class="h-full w-full max-w-[320px] opacity-80">
            <defs>
              <linearGradient id="fallback-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#4c8cff"></stop>
                <stop offset="50%" stop-color="#3cd3e4"></stop>
                <stop offset="100%" stop-color="#9cfa7c"></stop>
              </linearGradient>
            </defs>
            <g fill="none" stroke="url(#fallback-grad)" stroke-width="1.5" stroke-linecap="round">
              <path d="M20 30 L55 78 L90 118 M90 118 L150 118 L185 78 L220 30" />
              <circle cx="20" cy="30" r="5"></circle>
              <circle cx="55" cy="78" r="5"></circle>
              <circle cx="90" cy="118" r="5"></circle>
              <circle cx="150" cy="118" r="5"></circle>
              <circle cx="185" cy="78" r="5"></circle>
              <circle cx="220" cy="30" r="5"></circle>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES ===== -->
  <section class="px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <div data-reveal class="max-w-2xl">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">What we build</p>
        <h2 class="mt-3 text-[clamp(1.7rem,3.2vw,2.4rem)] font-semibold tracking-tight" style="font-family: var(--font-display); color: var(--text);">
          Eight fields, one accountable team.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {
          services.map((service) => (
            <a
              href="/services/"
              data-reveal-item
              data-tilt
              class="service-card ripple focus-ring group relative flex flex-col gap-4 rounded-2xl border p-5"
              style={`border-color: var(--border); background: var(--surface); --card-accent: ${service.accent};`}
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-lg"
                style={`background: color-mix(in srgb, ${service.accent} 16%, transparent); color: ${service.accent};`}
              >
                <svg
                  viewBox="0 0 48 48"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                  set:html={service.icon}
                />
              </span>
              <h3 class="text-[14.5px] font-semibold" style="color: var(--text);">
                {service.title}
              </h3>
              <p class="text-[13px] leading-relaxed" style="color: var(--muted);">
                {service.blurb}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== WHY V6 SOLUTIONS ===== -->
  <section class="px-4 py-20 sm:px-6 sm:py-28" style="background: var(--surface);">
    <div class="mx-auto max-w-6xl">
      <div data-reveal class="max-w-2xl">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-cyan);">Why V6 Solutions</p>
        <h2 class="mt-3 text-[clamp(1.7rem,3.2vw,2.4rem)] font-semibold tracking-tight" style="font-family: var(--font-display); color: var(--text);">
          Built by people who ship, not just design.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-3" data-reveal-group>
        <div data-reveal-item>
          <p class="text-sm font-semibold" style="color: var(--accent-blue);">01</p>
          <h3 class="mt-2 text-base font-semibold" style="color: var(--text);">Hardware and software, one roof</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted);">
            Most agencies pick one side. We do both — from a PCB to the app that talks to it.
          </p>
        </div>
        <div data-reveal-item>
          <p class="text-sm font-semibold" style="color: var(--accent-cyan);">02</p>
          <h3 class="mt-2 text-base font-semibold" style="color: var(--text);">Six founders, no handoffs</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted);">
            The people who scope the work are the people who build it — nothing gets lost between departments.
          </p>
        </div>
        <div data-reveal-item>
          <p class="text-sm font-semibold" style="color: var(--accent-lime);">03</p>
          <h3 class="mt-2 text-base font-semibold" style="color: var(--text);">We build things that work</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted);">
            Prototypes, MVPs and production systems — judged by whether they run, not just how they look in a deck.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRODUCT TEASER ===== -->
  <section class="px-4 py-20 sm:px-6 sm:py-28">
    <div
      class="mx-auto max-w-6xl overflow-hidden rounded-3xl border px-6 py-14 sm:px-14"
      style="border-color: var(--border); background: linear-gradient(135deg, color-mix(in srgb, var(--accent-blue) 14%, var(--surface)), var(--surface) 60%);"
      data-reveal
    >
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase" style="color: var(--accent-lime);">In development</p>
          <h2 class="mt-3 text-[clamp(1.6rem,3vw,2.2rem)] font-semibold tracking-tight" style="font-family: var(--font-display); color: var(--text);">
            Our first product: a low-cost IC Tester
          </h2>
          <p class="mt-4 text-sm leading-relaxed sm:text-base" style="color: var(--muted);">
            Affordable electronics test equipment, built because we needed one ourselves and couldn't find one that
            didn't cost a fortune. Proof we build products, not just services.
          </p>
        </div>
        <a
          href="/products/ic-tester/"
          data-magnetic
          class="ripple focus-ring press-feedback shrink-0 rounded-full px-6 py-3 text-sm font-semibold"
          style="background: var(--btn-bg); color: var(--btn-text);"
        >
          See the project
        </a>
      </div>
    </div>
  </section>

  <!-- ===== CLOSING CTA ===== -->
  <section class="px-4 pt-4 pb-24 text-center sm:px-6" data-reveal>
    <h2 class="mx-auto max-w-2xl text-[clamp(1.6rem,3.4vw,2.4rem)] font-semibold tracking-tight text-balance" style="font-family: var(--font-display); color: var(--text);">
      Have something to build?
    </h2>
    <p class="mx-auto mt-3 max-w-md text-sm" style="color: var(--muted);">Tell us what it is — we'll tell you honestly if we're the right fit.</p>
    <a
      href="/contact/"
      data-magnetic
      class="ripple focus-ring press-feedback mt-8 inline-block rounded-full px-7 py-3.5 text-sm font-semibold"
      style="background: var(--btn-bg); color: var(--btn-text);"
    >
      Get in touch
    </a>
  </section>
</BaseLayout>

<style>
  .hero-scene {
    z-index: 2;
  }
  .hero-fallback {
    z-index: 1;
    transition: opacity 0.6s ease;
  }
  [data-three-scene]:not(:empty) ~ .hero-fallback {
    opacity: 0;
  }

  .service-card {
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }
  .service-card:hover,
  .service-card:focus-visible {
    border-color: color-mix(in srgb, var(--card-accent) 55%, var(--border));
    box-shadow: 0 12px 32px -16px color-mix(in srgb, var(--card-accent) 45%, transparent);
  }
  [data-motion-tier='lite'] .service-card:hover {
    transform: translateY(-3px);
  }
</style>
